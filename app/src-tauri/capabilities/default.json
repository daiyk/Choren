{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Project files, user-selected import/export locations and app updates",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart"
  ]
}
