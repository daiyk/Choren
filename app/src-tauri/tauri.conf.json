{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Choren",
  "version": "0.3.1",
  "identifier": "com.choren.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && bash ../scripts/fetch-python-runtime.sh && python3 ../scripts/third-party-notices.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Choren",
        "dragDropEnabled": false,
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026, Yukun Dai",
    "license": "BSD-3-Clause",
    "resources": {
      "licenses/": "licenses/",
      "../../library/choren/": "library/choren/",
      "../../python/choren_host/": "python/choren_host/",
      "python-runtime/": "python-runtime/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQkJERjVFMTUwRUE0MUQKUldRZHBBNFZYdCs3L0o2cVROL2hUNG02Q2ttMWxUSHUxNk02UFJVQkhBMjdhbjRCMlJ2RzlHYm4K",
      "endpoints": [
        "https://github.com/daiyk/Choren/releases/latest/download/latest.json"
      ]
    }
  }
}
