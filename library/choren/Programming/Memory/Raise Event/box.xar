<?xml version="1.0" encoding="UTF-8" ?>
<ChoregrapheBox xar_version="3">
    <Box name="Raise Event" id="1" localization="8" tooltip="Raises an ALMemory event with the received value." x="0" y="0">
        <script language="4">
            <content>
                <![CDATA[class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onInput_onStart(self, value):
        self.session().service("ALMemory").raiseEvent(self.getParameter("Key"), value)
        self.onStopped()]]>
</content>
        </script>
        <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
        <Input name="onStart" type="0" type_size="1" nature="2" inner="0" tooltip="Value to raise." id="2" />
        <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Sent when the box has finished." id="3" />
        <Parameter name="Key" inherits_from_parent="0" content_type="3" value="Choren/MyEvent" default_value="Choren/MyEvent" tooltip="Memory key." id="4" />
    </Box>
</ChoregrapheBox>
