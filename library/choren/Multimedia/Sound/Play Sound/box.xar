<?xml version="1.0" encoding="UTF-8" ?>
<ChoregrapheBox xar_version="3">
    <Box name="Play Sound" id="1" localization="8" tooltip="Plays a sound file from the project." x="0" y="0">
        <script language="4">
            <content>
                <![CDATA[import os

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.player = self.session().service("ALAudioPlayer")
        self.task = None

    def onUnload(self):
        if self.task is not None:
            self.player.stop(self.task)
            self.task = None

    def onInput_onStart(self):
        path = os.path.join(self.behaviorAbsolutePath(), self.getParameter("File").lstrip("/"))
        self.task = self.player.post.playFile(path)
        self.player.wait(self.task, 0)
        self.task = None
        self.onStopped()

    def onInput_onStop(self):
        self.onUnload()
        self.onStopped()]]>
</content>
        </script>
        <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
        <Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Starts the box." id="2" />
        <Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Stops the box." id="3" />
        <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Sent when the box has finished." id="4" />
        <Parameter name="File" inherits_from_parent="0" content_type="4" value="" default_value="" tooltip="Sound file in the project." id="5" />
        <Resource name="Audio player" type="Lock" timeout="0" />
    </Box>
</ChoregrapheBox>
