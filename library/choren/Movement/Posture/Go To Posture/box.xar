<?xml version="1.0" encoding="UTF-8" ?>
<ChoregrapheBox xar_version="3">
    <Box name="Go To Posture" id="1" localization="8" tooltip="Moves the whole body to a predefined posture." x="0" y="0">
        <script language="4">
            <content>
                <![CDATA[class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.posture = self.session().service("ALRobotPosture")

    def onUnload(self):
        self.posture.stopMove()

    def onInput_onStart(self):
        done = self.posture.goToPosture(self.getParameter("Posture"), self.getParameter("Speed (%)") / 100.0)
        if done:
            self.success()
        else:
            self.failure()

    def onInput_onStop(self):
        self.onUnload()
        self.failure()]]>
</content>
        </script>
        <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
        <Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Starts the box." id="2" />
        <Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Stops the box." id="3" />
        <Output name="success" type="1" type_size="1" nature="1" inner="0" tooltip="Sent when the posture is reached." id="4" />
        <Output name="failure" type="1" type_size="1" nature="1" inner="0" tooltip="Sent when the posture could not be reached." id="5" />
        <Parameter name="Posture" inherits_from_parent="0" content_type="3" value="Stand" default_value="Stand" custom_choice="0" tooltip="Target posture." id="6">
            <Choice value="Stand" />
            <Choice value="StandInit" />
            <Choice value="StandZero" />
            <Choice value="Crouch" />
            <Choice value="Sit" />
            <Choice value="SitRelax" />
            <Choice value="LyingBack" />
            <Choice value="LyingBelly" />
        </Parameter>
        <Parameter name="Speed (%)" inherits_from_parent="0" content_type="1" value="80" default_value="80" min="1" max="100" tooltip="Movement speed." id="7" />
        <Resource name="All motors" type="Lock" timeout="0" />
        <Resource name="Standing" type="Lock" timeout="0" />
    </Box>
</ChoregrapheBox>
